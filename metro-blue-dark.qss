/* Основные настройки стиля */
* {
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    color: #333333;
}

/* Основной фон */
QWidget {
    background-color: #FFFFFF;
}

/* Кнопки */
QPushButton {
    background-color: #0078D7;
    border: 1px solid #0078D7;
    border-radius: 20px;
    color: #FFFFFF;
    padding: 10px 20px;
    font-size: 16px;
    margin: 5px;
}

QPushButton:hover {
    background-color: #005a9e;
}

QPushButton:pressed {
    background-color: #003d6d;
}

/* Слайдер */
QSlider::groove:horizontal {
    border: 1px solid #999999;
    height: 8px;
    background: #FFFFFF;
    margin: 2px 0;
}

QSlider::handle:horizontal {
    background: #0078D7;
    border: 1px solid #0078D7;
    width: 20px;
    margin: -2px 0;
    border-radius: 10px;
}

QSlider::handle:horizontal:hover {
    background: #005a9e;
}

QSlider::handle:horizontal:pressed {
    background: #003d6d;
}

/* Поле ввода */
QLineEdit {
    border: 1px solid #0078D7;
    border-radius: 10px;
    padding: 5px;
    background-color: #F0F0F0;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #005a9e;
}

/* Чекбокс */
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 1px solid #0078D7;
    border-radius: 5px;
}

QCheckBox::indicator:unchecked {
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #0078D7;
    border: 1px solid #0078D7;
    image: url(:/images/check.png);
}

/* Комбо бокс */
QComboBox {
    border: 1px solid #0078D7;
    border-radius: 10px;
    padding: 5px;
    font-size: 14px;
}

QComboBox:drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    border: 1px solid #0078D7;
    border-radius: 10px;
}

/* Группа элементов */
QGroupBox {
    border: 1px solid #0078D7;
    border-radius: 10px;
    padding: 10px;
    font-size: 16px;
    color: #333333;
}

/* Кнопка меню */
QToolButton {
    background-color: #0078D7;
    border: 1px solid #0078D7;
    border-radius: 20px;
    color: #FFFFFF;
    padding: 10px 20px;
    font-size: 16px;
    margin: 5px;
}

QToolButton:hover {
    background-color: #005a9e;
}

QToolButton:pressed {
    background-color: #003d6d;
}

/* Поле ввода с множественным выбором */
QListView {
    border: 1px solid #0078D7;
    border-radius: 10px;
    padding: 5px;
    background-color: #F0F0F0;
}

/* Основное окно */
QMainWindow {
    background-color: #FFFFFF;
}

